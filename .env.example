# TradingEngineResearch runtime configuration (copy to .env; .env is gitignored).
# Every key maps to core.config.EngineSettings (prefix ENGINE_, nested via __).
# NEVER put real secrets in a committed file — use the encrypted vault (python -m core.vault).

# ── core ──────────────────────────────────────────────────────────────────────
ENGINE_MODE=PAPER                     # RESEARCH | PAPER | LIVE (LIVE needs the two below)
ENGINE_CAPITAL_GBP=1000000
ENGINE_STALE_THRESHOLD_SECONDS=300

# The traded universe (JSON array) and the loop cadence (seconds).
ENGINE_UNIVERSE=["AAPL","MSFT","GOOG","AMZN","JPM"]
ENGINE_CYCLE_INTERVAL_SECONDS=86400   # daily

# ── LIVE arming (only when ENGINE_MODE=LIVE) ─────────────────────────────────
# ENGINE_CONFIRM_LIVE=true            # required: a lone MODE=LIVE must not arm real money
# ENGINE_AUDIT_LOG_PATH=/app/state/live_audit.md   # required: LIVE is never unaudited

# ── persistence ─────────────────────────────────────────────────────────────────
ENGINE_PERSISTENCE__BACKEND=json       # json (default, file) | sqlite (SqlStateStore)
ENGINE_PERSISTENCE__STATE_DIR=/app/state
ENGINE_PERSISTENCE__RETENTION_DAYS=90
# ENGINE_PERSISTENCE__DATABASE_URL=postgresql+psycopg://tradingengineresearch:change-me@db:5432/tradingengineresearch

# ── alerting / observability ────────────────────────────────────────────────────
ENGINE_ALERTING__SINK=both            # logging | jsonl | both | null
# ENGINE_ALERTING__ALERT_LOG_PATH=/app/state/alerts.jsonl

# ── broker (IBKR; consumed in LIVE) ──────────────────────────────────────────────
# ENGINE_BROKER__HOST=127.0.0.1
# ENGINE_BROKER__PORT=4001            # 7497 TWS paper · 7496 live · 4001/4002 gateway
# ENGINE_BROKER__CLIENT_ID=1
# ENGINE_BROKER__ACCOUNT_ID=          # or store the vault secret 'ibkr_account_id'

# ── vault (encrypted secrets) ────────────────────────────────────────────────────
# ENGINE_VAULT__DIRECTORY=/app/secrets
# ENGINE_VAULT__PASSPHRASE=           # supply at runtime; do NOT commit

# ── API (combined/api modes) ─────────────────────────────────────────────────────
ENGINE_API_HOST=0.0.0.0               # container-internal; compose maps to 127.0.0.1
ENGINE_API_PORT=8000
# ENGINE_API_TOKEN=                   # bearer token; REQUIRED to bind off-loopback
# Per-caller request budgets. Reads cover the observation endpoints (the dashboard
# polls ~100/min); writes are shared by /cycle/run, /kill-switch/reset and
# /reconciliation/resolve. 0 disables that budget; /health is never throttled.
# ENGINE_API_READ_RATE_LIMIT_PER_MINUTE=240
# ENGINE_API_WRITE_RATE_LIMIT_PER_MINUTE=10
# A request with the valid API token is budgeted as that token holder; everyone
# else shares the budget for their client address. Loopback and compose both give
# EVERY caller the same address, so leave the next one unset unless the API is
# unreachable except through a proxy that sets the header itself - it is
# caller-supplied, and trusting it lets anyone mint a fresh budget per request.
# ENGINE_API_TRUSTED_PROXY_HEADER=X-Forwarded-For
# TWO trails, on purpose. The first is every event, one line per request, capped at
# 5 MB x 5 - measured at 590 bytes per request, so ~53,000 requests roll it away and
# it IS allowed to roll. The second takes only WARNING and above (auth_failed,
# rate_limited, request_failed, denied/5xx), keeps 30 daily generations, and
# aggregates repeats to at most one line per (event, reason) per minute - so no
# request volume can erase the evidence of the attack that generated it.
# Both are durable logging, NOT alerting: nobody is paged; someone has to go and look.
# ENGINE_API_SECURITY_LOG_PATH=/app/state/security.jsonl
# ENGINE_API_SECURITY_ALERT_LOG_PATH=/app/state/security-alerts.jsonl
# ENGINE_API_SECURITY_LOG_ENABLED=true

# ── Postgres (only with: docker compose --profile postgres) ──────────────────────
# POSTGRES_PASSWORD=change-me
